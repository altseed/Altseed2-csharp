<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Altseed2</RootNamespace>
    <AssemblyName>Altseed2</AssemblyName>
     <TargetFramework>net5.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>$(SolutionDir)Build\$(Configuration)\</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(SolutionDir)Build\$(Configuration)\Altseed2.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Altseed2</AssemblyTitle>
    <Copyright>Copyright © 2020 Altseed</Copyright>
    <AssemblyVersion>2.2.2.0</AssemblyVersion>
    <FileVersion>2.2.2.0</FileVersion>
    <InformationalVersion>2.2.2</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='CI'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <Choose>
    <When Condition="'$(Platform)' == 'x64' And '$(Configuration)'=='Debug' And ('$(OS)' == 'Windows' Or '$(OS)' == 'Windows_NT')">
      <ItemGroup>
        <Content Include="..\Core\build\DEBUG\Altseed2_Core.dll">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
      </ItemGroup>
    </When>

    <When Condition="'$(Platform)' == 'x64' And ('$(Configuration)'=='Release' Or '$(Configuration)' == 'CI') And ('$(OS)' == 'Windows' Or '$(OS)' == 'Windows_NT')">
      <ItemGroup>
        <Content Include="..\Core\build\RELEASE\Altseed2_Core.dll">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
      </ItemGroup>
    </When>

    <When Condition="'$(Platform)' == 'x64' And '$(Configuration)'=='Debug' And $([MSBuild]::IsOsPlatform('OSX')) ">
      <ItemGroup>
        <Content Include="..\Core\build\DEBUG\libAltseed2_Core.dylib">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
      </ItemGroup>
    </When>

    <When Condition="'$(Platform)' == 'x64' And ('$(Configuration)'=='Release' Or '$(Configuration)' == 'CI') And $([MSBuild]::IsOsPlatform('OSX')) ">
      <ItemGroup>
        <Content Include="..\Core\build\RELEASE\libAltseed2_Core.dylib">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
      </ItemGroup>
    </When>

    <When Condition="'$(Platform)' == 'x64' And '$(Configuration)'=='Debug' And $([MSBuild]::IsOsPlatform('Linux')) ">
      <ItemGroup>
        <Content Include="..\Core\build\DEBUG\libAltseed2_Core.so">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
      </ItemGroup>
    </When>

    <When Condition="'$(Platform)' == 'x64' And ('$(Configuration)'=='Release' Or '$(Configuration)' == 'CI') And $([MSBuild]::IsOsPlatform('Linux')) ">
      <ItemGroup>
        <Content Include="..\Core\build\RELEASE\libAltseed2_Core.so">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
      </ItemGroup>
    </When>

  </Choose>

  <ItemGroup>
    <ProjectReference Include="..\PartsTreeSystem\PartsTreeSystem\PartsTreeSystem.csproj" />
  </ItemGroup>

</Project>
